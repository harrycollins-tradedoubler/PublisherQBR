# Copy to .env and fill in local values. Do not commit .env.

# Shared local API key used by the runner when it calls qbr-pptx-service.
PUBLISHER_QBR_API_KEY=td-publisher-qbr-local-2026-secret

# Active PPTX service dependency. Start qbr-pptx-service separately on this URL.
PUBLISHER_QBR_PPTX_SERVICE_URL=http://127.0.0.1:3010
QBR_PPTX_SERVICE_URL=http://127.0.0.1:3010

# Optional. Leave blank to use deterministic narrative output.
OPENAI_API_KEY=
PUBLISHER_QBR_AGENT_MODE=deterministic

# Host port for the local Publisher QBR runner.
PUBLISHER_QBR_LOCAL_RUNNER_PORT=3020

# Optional sanitized runner debug artifact directory.
PUBLISHER_QBR_DEBUG_DIR=publisher-qbr-local-runner/debug-runs
